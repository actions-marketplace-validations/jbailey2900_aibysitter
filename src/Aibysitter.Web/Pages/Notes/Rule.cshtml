@page "/Notes/{id}"
@model Aibysitter.Web.Pages.Notes.RuleModel
@{
    ViewData["Title"] = $"{Model.Doc.Id} {Model.Doc.Name}";
}

<p><a asp-page="/Notes/Index">All rules</a></p>

<h1>@Model.Doc.Id @Model.Doc.Name</h1>

<dl>
    <dt>Severity</dt>
    <dd>@Model.Severity (−@Aibysitter.Rules.Scorer.Weight(Model.Severity) per finding, max −@Aibysitter.Rules.Scorer.PerRuleCap)</dd>
    <dt>Summary</dt>
    <dd>@Model.Doc.Summary</dd>
    <dt>Flags</dt>
    <dd>@Model.Doc.Flags</dd>
</dl>

<h2>Flagged</h2>
<pre><code>@Model.Doc.BadExample</code></pre>

<h2>Passes</h2>
<pre><code>@Model.Doc.GoodExample</code></pre>
