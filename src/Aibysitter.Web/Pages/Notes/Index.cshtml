@page
@model Aibysitter.Web.Pages.Notes.IndexModel
@{
    ViewData["Title"] = "Notes";
}

<h1>Rule notes</h1>

<table>
    <thead>
        <tr>
            <th>Id</th>
            <th>Rule</th>
            <th>Severity</th>
            <th>Flags</th>
        </tr>
    </thead>
    <tbody>
        <tr><td>R001</td><td>RationaleProse</td><td>Info</td><td>Explanations in instruction text: "because", "so that", "in order to", "the reason", "this ensures", "this helps", "which means".</td></tr>
        <tr><td>R002</td><td>VagueVerbs</td><td>Warning</td><td>Unmeasurable wording: "handle", "manage", "deal with", "ensure", "improve", "optimize", "clean up", "properly", "appropriate(ly)", "as needed".</td></tr>
        <tr><td>R003</td><td>ContradictoryModals</td><td>Error</td><td>An instruction both required (always / must) and forbidden (never / must not / do not).</td></tr>
        <tr><td>R004</td><td>FileLength</td><td>Warning</td><td>Files over 200 lines.</td></tr>
        <tr><td>R005</td><td>DuplicateLines</td><td>Warning</td><td>Repeated lines, ignoring case, whitespace, and list markers.</td></tr>
    </tbody>
</table>

<p>Fenced code blocks are excluded from all rules. Headings are excluded from R001–R003.</p>
