@page
@model Aibysitter.Web.Pages.Notes.IndexModel
@{
    ViewData["Title"] = "Notes";
}

<h1>Notes</h1>
<p class="note">Looking for the rules? They moved to <a asp-page="/Rules/Index">/Rules</a>.</p>

<ul class="notes-list">
    @foreach (var note in Model.Notes)
    {
        <li>
            <h2><a asp-page="/Notes/Entry" asp-route-slug="@note.Slug">@note.Title</a></h2>
            <p class="note"><time datetime="@note.Date.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)">@note.Date.ToString("d MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</time></p>
            <p>@note.Summary</p>
        </li>
    }
</ul>
