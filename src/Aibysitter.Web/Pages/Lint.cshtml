@page
@model LintModel
@using Aibysitter.Rules
@using Aibysitter.Web.Linting
@{
    ViewData["Title"] = "Lint";
    ViewData["Description"] = "Paste a rules file or name a public GitHub repository. Findings by line, a fix for each, and a score.";
}

<h1>Lint a rules file</h1>

<form method="post" id="lint-form">
    <label for="Format">Format</label>
    <select asp-for="Format" asp-items="Model.FormatOptions" aria-describedby="format-help"></select>
    <p class="note" id="format-help">Auto-detect picks Cursor rule (.mdc) when the frontmatter has description, globs, or alwaysApply. The format only changes whether R015 and R016 run.</p>
    <label for="RulesText">Rules file content</label>
    <textarea asp-for="RulesText" rows="20" spellcheck="false" aria-describedby="text-help"></textarea>
    <p class="note" id="text-help">Linted in your browser; the text is not sent. Without JavaScript, the server lints it and does not store or log the text. <a asp-page="/Privacy">Privacy</a></p>
    <span asp-validation-for="RulesText" class="error"></span>
    <details class="rules-picker" open="@(Model.Disabled.Count > 0 ? "open" : null)">
        <summary>Rules</summary>
        <input type="hidden" name="RulesPosted" value="true" />
        <fieldset>
            <legend>Rules to run</legend>
            @foreach (var rule in Model.Rules)
            {
                <label><input type="checkbox" name="Enabled" value="@rule.Id" checked="@(Model.IsEnabled(rule.Id) ? "checked" : null)" /> @rule.Id @rule.Title</label>
            }
        </fieldset>
    </details>
    <button type="submit">Lint</button>
    <a class="sample-link" asp-page="/Lint" asp-route-sample="true">Try a sample</a>
</form>

<form method="post" asp-page-handler="Url" id="url-form" class="url-form">
    <label for="repo">Or lint a public GitHub repository</label>
    <input id="repo" name="repo" type="text" value="@Model.RepoText" placeholder="owner/repo or https://github.com/owner/repo" spellcheck="false" aria-describedby="repo-help" />
    <p class="note" id="repo-help">Reads @string.Join(", ", RawGitHubFetcher.FileNames) from the default branch, first found, through raw.githubusercontent.com. Nothing is stored or logged.</p>
    <button type="submit">Lint repository</button>
</form>

<div id="lint-results" aria-live="polite">
@if (Model.UrlLint is { } url)
{
    <partial name="_UrlLintResult" model="url" />
}
@if (Model.IsSample)
{
    <p class="note">This sample intentionally triggers six findings.</p>
}
@if (Model.LintedFormat is { } linted)
{
    <p class="note">Linted as @RulesFormats.DisplayName(linted)@(Model.Format == RulesFormat.Auto ? " (detected)" : "").</p>
    @if (Model.Disabled.Count > 0)
    {
        <p class="note">Rules off: @string.Join(", ", Model.Disabled).</p>
    }
}

@if (Model.Score is not null)
{
    <partial name="_ScorePanel" model="Model.Score" />
}

@if (Model.Results is not null)
{
    <h2>Findings (@Model.Results.Count)</h2>
    @if (Model.Results.Count == 0)
    {
        <p>No findings.</p>
    }
    else
    {
        <table class="findings stack">
            <thead>
                <tr>
                    <th>Line</th>
                    <th>Rule</th>
                    <th>Severity</th>
                    <th>Message</th>
                    <th>Fix</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Results)
                {
                    <tr class="sev-@row.Severity.ToString().ToLowerInvariant()">
                        <td>@row.Finding.Line</td>
                        <td><a asp-page="/Rules/Rule" asp-route-id="@row.Finding.RuleId">@row.Finding.RuleId</a> @row.Title</td>
                        <td>@row.Severity</td>
                        <td>@row.Finding.Message</td>
                        <td>@row.Finding.FixHint</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@if (Model.Suppressed is { Count: > 0 })
{
    <h2>Suppressed (@Model.Suppressed.Count)</h2>
    <p class="note">Matched by an <code>aibysitter-disable</code> comment. Not scored.</p>
    <table class="findings stack">
        <thead>
            <tr>
                <th>Line</th>
                <th>Rule</th>
                <th>Message</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Suppressed)
            {
                <tr>
                    <td>@row.Finding.Line</td>
                    <td><a asp-page="/Rules/Rule" asp-route-id="@row.Finding.RuleId">@row.Finding.RuleId</a> @row.Title</td>
                    <td>@row.Finding.Message</td>
                </tr>
            }
        </tbody>
    </table>
}
</div>

@section Scripts {
    <script type="module" src="~/js/lint-page.mjs" asp-append-version="true"></script>
}
