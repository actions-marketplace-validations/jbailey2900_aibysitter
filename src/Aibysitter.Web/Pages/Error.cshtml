@page
@model ErrorModel
@{
    // Standalone: no layout, no injected services, no route generation. Renders when catalogs or other services fail.
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex" />
    <title>Error - aibysitter</title>
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body class="error-page">
    <main>
        <h1>Error</h1>
        <p>An error occurred while processing your request.</p>
        @if (Model.ShowRequestId)
        {
            <p>Request ID: <code>@Model.RequestId</code></p>
        }
        <p><a href="/">aibysitting.net</a></p>
    </main>
</body>
</html>
