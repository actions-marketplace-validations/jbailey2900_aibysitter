@page
@model IndexModel
@{
    ViewData["Title"] = "Lint the rules you give AI coding agents";
    var demo = Model.Demo;
}

<section class="hero">
    <h1>Lint the rules you give AI coding agents.</h1>
    <p class="lede">Paste a CLAUDE.md or AGENTS.md. Get line-level findings and a score for the instructions your agent reads before it writes code.</p>
    <p class="actions">
        <a class="button primary" asp-page="/Lint">Lint a file</a>
        <a class="button" asp-page="/Lint" asp-route-sample="true">Open the sample</a>
    </p>
</section>

<figure class="terminal" aria-label="Example lint run">
    <pre><code><span class="t-prompt">$</span> aibysitter lint @demo.FileName
@foreach (var line in demo.Lines)
{
@:<span class="t-loc">@demo.FileName:@line.Line.ToString().PadRight(3)</span> <span class="t-sev t-@line.Severity.ToString().ToLowerInvariant()">@line.Severity.ToString().ToLowerInvariant().PadRight(7)</span> <span class="t-rule">@line.RuleId</span>  @line.Message
}
<span class="t-sum">@demo.Lines.Count findings, score @demo.Score.Value/100 (@demo.Score.Grade)</span>
<span class="t-prompt">$</span> <span class="cursor" aria-hidden="true"></span></code></pre>
    <figcaption>Output from the embedded sample, linted by the same engine as the <a asp-page="/Lint">lint page</a>.</figcaption>
</figure>

<section class="section">
    <h2>What it checks</h2>
    <div class="columns">
        <div>
            <h3>Rules files</h3>
            <ul class="marks">
                @foreach (var doc in Model.RuleDocs)
                {
                    <li><a asp-page="/Notes/Rule" asp-route-id="@doc.Id">@doc.Id</a> @doc.Summary</li>
                }
            </ul>
        </div>
        <div>
            <h3>Pull requests</h3>
            <ul class="marks">
                @foreach (var check in Model.PullRequestChecks)
                {
                    <li><a asp-page="/Notes/Rule" asp-route-id="@check.Id">@check.Id</a> @check.Title</li>
                }
            </ul>
            <p class="note">Pull request checks run through the <a asp-page="/GitHub">Aibysitter GitHub App</a>, currently in testing.</p>
        </div>
    </div>
</section>

<section class="section">
    <h2>Example rules files</h2>
    <p>Public-domain CLAUDE.md and AGENTS.md files for common stacks, each scored by the linter.</p>
    <ul class="marks">
        @foreach (var entry in Model.GalleryEntries)
        {
            <li><a asp-page="/Gallery/Entry" asp-route-id="@entry.Id">@entry.Name</a></li>
        }
    </ul>
    <p><a asp-page="/Gallery/Index">Browse the gallery</a></p>
</section>

<section class="section">
    <h2>How scoring works</h2>
    <p>Every file starts at 100. Each error costs 10 points, each warning 4 and each info 1, and no single rule can cost more than 30. A is 90 and up; F is below 60. Code blocks are ignored.</p>
    <p><a asp-page="/Notes/Index">Read the rules</a></p>
</section>
