@model Aibysitter.Rules.LintScore

<section class="score grade-@Model.Grade.ToLowerInvariant()">
    <h2>Aibysitter lint score</h2>
    <p class="score-value">@Model.Value / 100 — @Model.Grade</p>
    <p class="note">Ruleset <a asp-page="/Rules/Changelog">v@(Aibysitter.Rules.RulesetVersion.Current)</a></p>
    @if (Model.DeductionsByRule.Count == 0)
    {
        <p>No deductions.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Rule</th>
                    <th>Deduction</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (ruleId, points) in Model.DeductionsByRule)
                {
                    <tr>
                        <td><a asp-page="/Rules/Rule" asp-route-id="@ruleId">@ruleId</a></td>
                        <td>−@points</td>
                    </tr>
                }
            </tbody>
            @if (Model.DeductionsBySeverity.Any(d => d.Value.IsCapped))
            {
                <tfoot>
                    @foreach (var (severity, deduction) in Model.DeductionsBySeverity.Where(d => d.Value.IsCapped))
                    {
                        <tr>
                            <td>@severity cap</td>
                            <td>−@deduction.Applied (of −@deduction.Total)</td>
                        </tr>
                    }
                </tfoot>
            }
        </table>
    }
</section>
