<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - aibysitter</title>
    <link rel="preload" href="~/fonts/jetbrains-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
        <nav class="nav" aria-label="Main">
            <a class="wordmark" asp-page="/Index" aria-label="aibysitter home">aibysitter<span class="cursor" aria-hidden="true"></span></a>
            <ul class="nav-links">
                <li><a asp-page="/Lint">lint</a></li>
                <li><a asp-page="/Gallery/Index">gallery</a></li>
                <li><a asp-page="/Notes/Index">rules</a></li>
            </ul>
        </nav>
    </header>
    <main id="main">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <p>Babysitting the AI. Free to use, no account.</p>
    </footer>
</body>
</html>
