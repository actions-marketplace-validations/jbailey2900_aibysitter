@inject Aibysitter.Web.Infrastructure.SiteOptions Site
@{
    var description = ViewData["Description"] as string;
    var canonical = Site.Url(ViewData["Canonical"] as string ?? Url.Page((string)ViewContext.RouteData.Values["page"]!)!);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - aibysitter</title>
    @if (description is not null)
    {
        <meta name="description" content="@description" />
    }
    <link rel="canonical" href="@canonical" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="aibysitter" />
    <meta property="og:title" content="@ViewData["Title"]" />
    @if (description is not null)
    {
        <meta property="og:description" content="@description" />
    }
    <meta property="og:url" content="@canonical" />
    <meta name="twitter:card" content="summary" />
    <link rel="preload" href="~/fonts/jetbrains-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
        <nav class="nav" aria-label="Main">
            <a class="wordmark" asp-page="/Index" aria-label="aibysitter home">aibysitter<span class="cursor" aria-hidden="true"></span></a>
            <ul class="nav-links">
                <li><a asp-page="/Lint">lint</a></li>
                <li><a asp-page="/Gallery/Index">gallery</a></li>
                <li><a asp-page="/Packs/Index">packs</a></li>
                <li><a asp-page="/Rules/Index">rules</a></li>
                <li><a asp-page="/GitHub">github</a></li>
            </ul>
        </nav>
    </header>
    <main id="main">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <p>Babysitting the AI. Free to use, no account.</p>
        <p><a asp-page="/About">About</a> · <a asp-page="/Privacy">Privacy</a> · <a asp-page="/Notes/Index">Notes</a> · <a asp-page="/Incidents/Index">Incidents</a> · <a asp-page="/Stats">Stats</a> · <a asp-page="/Api">API</a> · <a asp-page="/Hooks">Hooks</a></p>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
