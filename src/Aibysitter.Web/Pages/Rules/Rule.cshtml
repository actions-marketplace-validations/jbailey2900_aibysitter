@page "/Rules/{id}"
@model Aibysitter.Web.Pages.Rules.RuleModel
@{
    ViewData["Title"] = Aibysitter.Web.Seo.RuleSearchTitles.For(Model.Doc.Id, Model.Doc.Name);
    ViewData["Description"] = Model.Doc.Summary;
    ViewData["Canonical"] = Aibysitter.Web.Seo.SiteMap.RulePath(Model.Doc.Id);
}

<p><a asp-page="/Rules/Index">All rules</a></p>

<h1>@Model.Doc.Id @Model.Doc.Name</h1>

<dl>
    <dt>Applies to</dt>
    @if (Model.IsPullRequestCheck)
    {
        <dd>Pull requests, through the <a asp-page="/GitHub">GitHub App</a></dd>
    }
    else if (Model.Doc.AppOnly)
    {
        <dd>App-only. Rules files in pull requests, through P014 in the <a asp-page="/GitHub">GitHub App</a>. Not run on the lint page.</dd>
    }
    else
    {
        <dd>@(Model.Doc.Id is "R015" or "R016" ? "Cursor rules (.mdc)" : "Rules files (CLAUDE.md, AGENTS.md, .mdc, .cursorrules, Copilot instructions, GEMINI.md, .windsurfrules)")</dd>
    }
    <dt>Severity</dt>
    @if (Model.IsPullRequestCheck)
    {
        <dd>@Model.Severity@(Model.Severity == Aibysitter.Rules.Severity.Error ? " (fails the check when the repo sets fail-on-errors)" : "")</dd>
    }
    else if (Model.Doc.AppOnly)
    {
        <dd>@Model.Severity (P014 finding; not scored)</dd>
    }
    else
    {
        <dd>@Model.Severity (−@Aibysitter.Rules.Scorer.Weight(Model.Severity) per finding, max −@Aibysitter.Rules.Scorer.PerRuleCap)</dd>
    }
    <dt>Summary</dt>
    <dd>@Model.Doc.Summary</dd>
    <dt>Flags</dt>
    <dd>@Model.Doc.Flags</dd>
    @if (Aibysitter.Rules.RulesFileFixer.FixableRules.Contains(Model.Doc.Id))
    {
        <dt>Fixable</dt>
        <dd><code>aibysitter fix</code> @(Model.Doc.Id switch
        {
            Aibysitter.Rules.RulesFileFixer.EmptySections => "deletes the empty heading and the blank lines after it.",
            _ => "adds a matching closing fence at the end of the file. Check where the code block should end.",
        }) <a asp-page="/Hooks">CLI</a></dd>
    }
</dl>

<h2>Before</h2>
<pre><code>@Model.Doc.BadExample</code></pre>

<h2>After</h2>
<pre><code>@Model.Doc.GoodExample</code></pre>

@if (Model.FixHints.Count > 0)
{
    <h2>Fix</h2>
    <ul class="fix-hints">
        @foreach (var hint in Model.FixHints)
        {
            <li>@hint</li>
        }
    </ul>
}

@if (Model.Doc.Id is "R015" or "R016")
{
    <partial name="_CursorModes" />
}
