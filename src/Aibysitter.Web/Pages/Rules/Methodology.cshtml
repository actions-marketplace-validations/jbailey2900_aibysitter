<h2>Thresholds</h2>
<p>Corpus hit rates are from the 336-file corpus with the current rules.</p>
<table class="stack">
    <thead>
        <tr>
            <th>Rule</th>
            <th>Threshold</th>
            <th>Corpus files flagged</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><a asp-page="/Rules/Rule" asp-route-id="R004">R004</a> FileLength</td>
            <td>More than @FileLength.MaxLines lines</td>
            <td>129 of 336 (38.4%)</td>
        </tr>
        <tr>
            <td><a asp-page="/Rules/Rule" asp-route-id="R008">R008</a> EmphasisInflation</td>
            <td>More than @EmphasisInflation.PerHundredLines emphasis lines per 100 lines, at least @EmphasisInflation.MinAllowed allowed</td>
            <td>10 of 336 (3.0%)</td>
        </tr>
        <tr>
            <td><a asp-page="/Rules/Rule" asp-route-id="R013">R013</a> ProseParagraph</td>
            <td>A paragraph of more than @ProseParagraph.MaxWords words</td>
            <td>59 of 336 (17.6%)</td>
        </tr>
    </tbody>
</table>

