@page
@model Aibysitter.Web.Pages.Rules.MethodologyModel
@using Aibysitter.Rules
@using Aibysitter.Rules.Rules
@{
    ViewData["Title"] = "Methodology";
}

<p><a asp-page="/Rules/Index">All rules</a></p>

<h1>Methodology</h1>

<h2>How rules were chosen</h2>
<ul>
    <li>Each lint rule reads the rules file text only. No agent is run and no repository is read; R006 is the exception and runs only in the GitHub App, where the repository is available.</li>
    <li>Each rule was run against a corpus of 336 public CLAUDE.md and AGENTS.md files before it shipped. A rule ships when fewer than 5% of corpus files get a finding that is a false positive and nothing else.</li>
    <li>Thresholds (line counts, word counts, ratios) are fixed constants in the rule code and apply to every file the same way.</li>
</ul>

<h2>Severities</h2>
<table class="stack">
    <thead>
        <tr>
            <th>Severity</th>
            <th>Cost per finding</th>
            <th>Meaning</th>
            <th>Rules</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>Error</td>
            <td>−@Scorer.Weight(Severity.Error)</td>
            <td>The file is broken or unsafe as written: an instruction contradicts another, a secret is exposed, or markup swallows the rest of the file.</td>
            <td>@string.Join(", ", Model.RulesBySeverity.GetValueOrDefault(Severity.Error) ?? [])</td>
        </tr>
        <tr>
            <td>Warning</td>
            <td>−@Scorer.Weight(Severity.Warning)</td>
            <td>An instruction or structure the agent cannot act on reliably: vague or hedged wording, repetition, length, emphasis, empty sections, frontmatter Cursor ignores, references that do not exist.</td>
            <td>@string.Join(", ", Model.RulesBySeverity.GetValueOrDefault(Severity.Warning) ?? [])</td>
        </tr>
        <tr>
            <td>Info</td>
            <td>−@Scorer.Weight(Severity.Info)</td>
            <td>Text that is not an instruction: rationale, persona, long prose, references to unnamed context.</td>
            <td>@string.Join(", ", Model.RulesBySeverity.GetValueOrDefault(Severity.Info) ?? [])</td>
        </tr>
    </tbody>
</table>
<partial name="_Scoring" />

